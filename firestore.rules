rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Order creation and payment confirmation happen only in Cloud Functions.
    // This keeps recipient addresses, prices, and promo enforcement off the
    // browser, while still allowing guests to check out.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // Address requests are accessed only through Cloud Functions, which keep
    // both the submitted address and the sender's claim secret off the client.
    match /addressRequests/{requestId} {
      allow read, write: if false;
    }

    match /senderEmailVerifications/{verificationId} {
      allow read, write: if false;
    }
  }
}
